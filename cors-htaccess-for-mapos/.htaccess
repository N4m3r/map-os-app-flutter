# Coloque este arquivo na raiz do MAP-OS (mesma pasta do index.php)
# Isso habilita CORS para o app Flutter funcionar no navegador (Chrome/Web)

<IfModule mod_headers.c>
    # Permitir requisicoes de qualquer origem (necessario para o app web)
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, App-Version"
    Header set Access-Control-Max-Age "86400"

    # Responder preflight OPTIONS com 200
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>